# Public example. Replace these values for your own deployment.
export MODEL_NAME=your-model
export MODEL_HOST_PATH=/mnt/models/your-model
export HOST_IP=192.168.1.10
export HOST_PORT=8000
# single_* throughput = global throughput / NPU_NUM.
# Use total physical cards for per-card reports, or total NPU chips for per-chip reports.
# A3 has 2 NPU chips per physical card; declare the report unit. Default 1 is an example.
export NPU_NUM=1
# Optional prefill metrics endpoints, for example:
# export POD_INFO="192.168.1.10:9081,192.168.1.11:9081"
export POD_INFO=""
export MAX_CONTEXT_LEN=133120
# 0: expand above the initial maximum; 1: stop at each scenario's maximum.
export PEAK_HARD_CAP=1
