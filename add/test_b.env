# Public parallel example B. Edit values, then pass both files to run_perf_scenarios.sh.
# Parallel mode loads this complete configuration automatically; no source is needed.
export MODEL_NAME=your-model-b
export MODEL_HOST_PATH=/mnt/models/your-model-b
export HOST_IP=192.168.1.20
export HOST_PORT=8000
export EXPECTED_IMAGE=ghcr.io/aisbench/aisbench_benchmark:v3.1-20261013-master-openeuler24.03-py311
# single_* throughput = global throughput / NPU_NUM; declare cards or NPU chips in your report.
export NPU_NUM=1
export POD_INFO=""
export API_KEY=""
export API_URL=""
export MAX_CONTEXT_LEN=4096
export DATA_NUM_MULTIPLIER=4
export PEAK_HARD_CAP=1
# Container name and output directory are derived from this file's name.

# Edit the JSON here. The launcher reads it from this file, not from an environment variable.
SCENARIOS_JSON=$(cat <<'JSON'
[
  {
    "name": "smoke_b",
    "input_len": "1024",
    "output_len": "512",
    "concurrency": [4],
    "request_rate": "0"
  }
]
JSON
)
export -n SCENARIOS_JSON
