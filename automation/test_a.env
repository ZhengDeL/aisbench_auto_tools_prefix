# Public complete example A. Edit actual model, path, endpoint and NPU count first.
# Run alone: bash run_perf_scenarios.sh ./test_a.env
# Or pass 1..N complete config files to run independent services in parallel.
# Explicit config arguments are loaded automatically; no source is needed.
export MODEL_NAME=your-model-a
export MODEL_HOST_PATH=/mnt/models/your-model-a
export HOST_IP=192.168.1.10
export HOST_PORT=8000
export EXPECTED_IMAGE=ghcr.io/aisbench/aisbench_benchmark:v3.1-20261013-master-openeuler24.03-py311
# single_* throughput = global throughput / NPU_NUM; declare cards or NPU chips in your report.
export NPU_NUM=1
export POD_INFO=""
export API_KEY=""
export API_URL=""
# Same API_URL host/port (or HOST_IP/HOST_PORT) is forbidden within/across local batches.
# Another model alias or URL path does not make the endpoint independent.
# For distinct proxies sharing one backend, set the same ID in every related config:
# export SERVICE_ID=shared-backend-01
# Different ports may run together only when they represent independent model instances.
# These locks coordinate this host only; coordinate other benchmark hosts separately.
export MAX_CONTEXT_LEN=4096
export DATA_NUM_MULTIPLIER=4
export PEAK_HARD_CAP=1
# Task name comes from the actual config file name; a/b are examples, not fixed groups.
# Default container: aisbench-test_a-<batch_id> (new name for each batch).
# Output labels include test_a__your-model-a.
# Defaults: outputs/parallel/<batch>/tasks/test_a__your-model-a/
# Named CSV: test_a__your-model-a__all_results.csv
# Named log: test_a__your-model-a__launcher.log
# Optional CONTAINER_NAME / HOST_OUTPUT_DIR must be distinct for every task.
# Batch status/merged metrics record task/model, actual paths, timezone and redacted config.

# Edit the JSON here. The launcher reads it from this file, not from an environment variable.
SCENARIOS_JSON=$(cat <<'JSON'
[
  {
    "name": "smoke_a",
    "input_len": "1024",
    "output_len": "512",
    "concurrency": [4],
    "request_rate": "0"
  }
]
JSON
)
export -n SCENARIOS_JSON
