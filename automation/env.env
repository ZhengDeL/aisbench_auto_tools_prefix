# Public complete example. Replace these values for your own deployment.
# Run: bash run_perf_scenarios.sh ./env.env (loads this file automatically).
# Pass 1..N complete config files; each task has its own container and task__model outputs.
# No-argument compatibility: source ./env.env; bash run_perf_scenarios.sh.
export MODEL_NAME=your-model
export MODEL_HOST_PATH=/mnt/models/your-model
export HOST_IP=192.168.1.10
export HOST_PORT=8000
# One endpoint cannot be tested concurrently, even with another model alias or URL path.
# API_URL, when set, is used before HOST_IP/HOST_PORT for service identity.
# For different proxies sharing one backend, give every config the same SERVICE_ID:
# export SERVICE_ID=shared-backend-01
# Locks apply across batches on this benchmark host, not across different hosts.
# single_* throughput = global throughput / NPU_NUM.
# Use total physical cards for per-card reports, or total NPU chips for per-chip reports.
# A3 has 2 NPU chips per physical card; declare the report unit. Default 1 is an example.
export NPU_NUM=1
# Optional prefill metrics endpoints, for example:
# export POD_INFO="192.168.1.10:9081,192.168.1.11:9081"
export POD_INFO=""
export MAX_CONTEXT_LEN=133120
# 0: expand above the initial maximum; 1: stop at each scenario's maximum.
export PEAK_HARD_CAP=1

# 场景配置：直接编辑 JSON 数组，脚本从本文件读取；不要 export。
# 显式传入本文件会自动加载上方参数，无需手动 source。
SCENARIOS_JSON=$(cat <<'JSON'
[
  {
    "name": "0_ai_coding_64k256",
    "input_len": "65536",
    "output_len": "256",
    "concurrency": [1, 10, 20, 50, 100, "max"],
    "request_rate": "0",
    "ttft_limit": 15,
    "tpot_limit": 60,
    "peak_min_cc": 1,
    "peak_max_cc": 200,
    "peak_data_multiplier": 4,
    "peak_wait": 10,
    "dataset_type": "prefix_cache",
    "prefix_num": "1",
    "repeat_rate": "0.9",
    "prefix_test": true
  },
  {
    "name": "0_ai_coding_64k1k",
    "input_len": "65536",
    "output_len": "1024",
    "concurrency": [1, 10, 20, 50, 100, "max"],
    "request_rate": "0",
    "ttft_limit": 15,
    "tpot_limit": 60,
    "peak_min_cc": 1,
    "peak_max_cc": 200,
    "peak_data_multiplier": 4,
    "peak_wait": 10,
    "dataset_type": "prefix_cache",
    "prefix_num": "1",
    "repeat_rate": "0.9",
    "prefix_test": true
  }
]
JSON
)
export -n SCENARIOS_JSON
