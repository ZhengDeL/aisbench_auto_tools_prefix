# 代码默认: "0"
# 本文件全局有效值: "1" （本文件赋值）
# 类型/单位: 0或1；硬顶开关
# 作用域: 全部摸高场景
# 覆盖: 无同名场景覆盖；1以各场景peak_max_cc封顶，0允许向上扩容但仍受预算约束
# 空值: 空=使用代码默认0；本文件当前明确配置为1
# 本文件场景覆盖: 无显式对应字段；按上述作用域及优先级生效。
# 示例: export PEAK_HARD_CAP=1
# @end
#
# @env PEAK_PRECISION
# 代码默认: "1"
# 本文件全局有效值: "1" （本文件未赋值，使用代码默认/自动规则）
# 类型/单位: 正整数；配置并发的边界间隔
# 作用域: 摸高候选边界精度
# 覆盖: 场景peak_precision优先；不代表实测平均并发精度
# 空值: 空=使用代码默认1
# 本文件场景覆盖: 无显式对应字段；按上述作用域及优先级生效。
# 示例: export PEAK_PRECISION=1
# @end
#
# @env PEAK_CONFIRM_RUNS
# 代码默认: "3"
# 本文件全局有效值: "3" （本文件未赋值，使用代码默认/自动规则）
# 类型/单位: 正整数；每个确认并发点新的工具trial次数
# 作用域: 摸高边界确认
# 覆盖: 场景peak_confirm_runs优先；通过/失败两端各执行本次数，不是原生repeat，也不读取探索缓存充数
# 空值: 空=使用代码默认3
# 本文件场景覆盖: 无显式对应字段；按上述作用域及优先级生效。
# 示例: export PEAK_CONFIRM_RUNS=3
# @end
#
# @env PEAK_CONFIRM_MIN_REQUESTS
# 代码默认: "100"
# 本文件全局有效值: "100" （本文件未赋值，使用代码默认/自动规则）
# 类型/单位: 整数>=0；每个主测scope的确认请求下限
# 作用域: 确认profile及随后补搜
# 覆盖: 场景peak_confirm_min_requests优先；生成数据每scope取max(CC×摸高倍率,本值)；显式dataset保留全量，实际记录不足下限则INVALID；不能代替统计置信证明
# 空值: 空=使用代码默认100；0=不加额外下限
# 本文件场景覆盖: 无显式对应字段；按上述作用域及优先级生效。
# 示例: export PEAK_CONFIRM_MIN_REQUESTS=100
# @end
#
# @env PEAK_MAX_TRIALS
# 代码默认: "40"
# 本文件全局有效值: "40" （本文件未赋值，使用代码默认/自动规则）
# 类型/单位: 正整数；工具trial总次数预算
# 作用域: 每个摸高场景
# 覆盖: 场景peak_max_trials优先；探索/确认/无效重试均计数；原生repeat scope另记实际消耗
# 空值: 空=使用代码默认40
# 本文件场景覆盖: 无显式对应字段；按上述作用域及优先级生效。
# 示例: export PEAK_MAX_TRIALS=40
# @end
#
# @env PEAK_TRIAL_TIMEOUT
# 代码默认: "1800"
# 本文件全局有效值: "1800" （本文件未赋值，使用代码默认/自动规则）
# 类型/单位: 有限数值>0；秒
# 作用域: 固定轮次和摸高单次工具trial超时，包含准备及全部repeat scope
# 覆盖: 仅摸高可用场景peak_trial_timeout覆盖；固定轮次始终使用本全局值
# 空值: 空=使用代码默认1800；0无效
# 本文件场景覆盖: 无显式对应字段；按上述作用域及优先级生效。
# 示例: export PEAK_TRIAL_TIMEOUT=1800
# @end
#
# @env PEAK_TOTAL_TIMEOUT
# 代码默认: "14400"
# 本文件全局有效值: "14400" （本文件未赋值，使用代码默认/自动规则）
# 类型/单位: 有限数值>0；秒
# 作用域: 每个摸高场景的总耗时预算
# 覆盖: 场景peak_total_timeout优先；包含所有trial、预热和等待
# 空值: 空=使用代码默认14400；0无效
# 本文件场景覆盖: 无显式对应字段；按上述作用域及优先级生效。
# 示例: export PEAK_TOTAL_TIMEOUT=14400
# @end
#
# @env PEAK_INVALID_RETRIES
# 代码默认: "1"
# 本文件全局有效值: "1" （本文件未赋值，使用代码默认/自动规则）
# 类型/单位: 整数>=0；无效测量的额外重试次数
# 作用域: 摸高测量缺失/无效
# 覆盖: 场景peak_invalid_retries优先；基础设施/请求错误不盲重试；重试也消耗trial和时间预算
# 空值: 空=使用代码默认1；0=不重试
# 本文件场景覆盖: 无显式对应字段；按上述作用域及优先级生效。
# 示例: export PEAK_INVALID_RETRIES=1
# @end
#
# @env PEAK_FLOOR_CONCURRENCY
# 代码默认: "1"
# 本文件全局有效值: "1" （本文件未赋值，使用代码默认/自动规则）
# 类型/单位: 正整数；独立硬底配置并发
# 作用域: 摸高向下探测
# 覆盖: 场景peak_floor_cc优先；不能大于初始peak_min_cc；不改变min作为初始下界的语义
# 空值: 空=使用代码默认1
# 本文件场景覆盖: 无显式对应字段；按上述作用域及优先级生效。
# 示例: export PEAK_FLOOR_CONCURRENCY=1
# @end
#
# 二、场景JSON字段：既有28个 + 新增8个摸高覆盖字段，共36个。
# JSON字段写在SCENARIOS_JSON数组的对象里，不写成export环境变量；true/false使用JSON布尔值。
# 只有concurrency含"max"才执行摸高；仅固定并发的示例不会因全局存在PEAK_*而自动摸高。
# 原生数据/长度/accuracy/think/repeat等按其适用分支执行；接受参数不等于已经验证该模型能力。
# @scene concurrency
# 说明: 非空数组，默认[1]；正整数可重复并按顺序执行，"max"最多一次表示摸高；任务数与请求并发不同。
# @scene data_num
# 说明: 正整数；生成数据的固定主测请求数，未填为CC×DATA_NUM_MULTIPLIER；accuracy默认取该数量真题；显式dataset按原生全量执行、不按data_num截取；摸高生成数据由自身倍率计算。
# @scene dataset
# 说明: 字符串，原生默认"none"；显式文件必须在容器内可读，使用全部记录、不按data_num截取或补齐；不等同dataset_type。
# @scene dataset_type
# 说明: "normal"或"prefix_cache"，默认normal；决定数据生成和前缀测试分支。
# @scene dp
# 说明: 正整数，默认1；原生dp参数，不由POD_INFO端点数量自动推导。
# @scene enable_think
# 说明: JSON布尔值，默认false；true按原生发送enable_thinking=true，false省略该请求字段，不保证模型关闭思考；结合目标模型和产物核验。
# @scene input_len
# 说明: 正整数，token；省略默认512；实际token长度以原始产物为准；accuracy保留真题、不按此值padding，配置上下文门禁仍执行。
# @scene length_max
# 说明: 正整数，token；与length_min成对填写，区间上端/正态截断参数；为模板和长尾留上下文余量。
# @scene length_mean
# 说明: 正整数，token；与length_std成对填写，正态长度均值；优先级及截断由原生采样实现决定。
# @scene length_min
# 说明: 正整数，token；与length_max成对填写，区间下端/正态截断参数；原生会交换反向边界。
# @scene length_std
# 说明: 有限非负数，token；与length_mean成对填写，正态长度标准差。
# @scene name
# 说明: 非空字符串，必填；场景内唯一，不能含单引号、竖线、换行或NUL；用于归档身份。
# @scene npu_num
# 说明: 正整数；覆盖全局NPU_NUM，决定single_*归一化分母，须说明卡/芯片口径。
# @scene output_len
# 说明: 正整数，token；省略默认128；摸高需>=2，固定单token仍支持。
# @scene peak_confirm_min_requests
# 说明: 整数>=0；每个主测scope实际完成请求下限；覆盖PEAK_CONFIRM_MIN_REQUESTS；生成数据每scope取max(CC×摸高倍率,本值)，显式dataset保留全量，实际记录不足下限则INVALID。
# @scene peak_confirm_runs
# 说明: 正整数；每个确认并发点新的工具trial次数；覆盖PEAK_CONFIRM_RUNS；通过/失败两端各执行本次数，不是原生repeat，也不读取探索缓存充数。
# @scene peak_data_multiplier
# 说明: 正整数；覆盖PEAK_DATA_MULTIPLIER；生成数据的请求数倍率，显式dataset仍保留全量；不是步长或复测次数。
# @scene peak_floor_cc
# 说明: 正整数；独立硬底配置并发；覆盖PEAK_FLOOR_CONCURRENCY；场景peak_floor_cc优先；不能大于初始peak_min_cc；不改变min作为初始下界的语义。
# @scene peak_invalid_retries
# 说明: 整数>=0；无效测量的额外重试次数；覆盖PEAK_INVALID_RETRIES；场景peak_invalid_retries优先；基础设施/请求错误不盲重试；重试也消耗trial和时间预算。
# @scene peak_max_cc
# 说明: 正整数且>=peak_min_cc；初始上界，PEAK_HARD_CAP=1时同时为硬顶。
# @scene peak_max_trials
# 说明: 正整数；工具trial总次数预算；覆盖PEAK_MAX_TRIALS；场景peak_max_trials优先；探索/确认/无效重试均计数；原生repeat scope另记实际消耗。
# @scene peak_min_cc
# 说明: 正整数；覆盖PEAK_MIN_CONCURRENCY，是初始基线而非硬底。
# @scene peak_precision
# 说明: 正整数；配置并发的边界间隔；覆盖PEAK_PRECISION；场景peak_precision优先；不代表实测平均并发精度。
# @scene peak_total_timeout
# 说明: 有限数值>0；秒；覆盖PEAK_TOTAL_TIMEOUT；场景peak_total_timeout优先；包含所有trial、预热和等待。
# @scene peak_trial_timeout
# 说明: 有限数值>0；秒；仅摸高覆盖PEAK_TRIAL_TIMEOUT，包含准备及全部repeat scope；固定轮次不读取此场景字段，使用全局超时。
# @scene peak_wait
# 说明: 整数>=0，秒；覆盖PEAK_WAIT_SECONDS，等待仍计总预算。
# @scene prefix_num
# 说明: 正整数，默认1；前缀组数，适用于prefix_cache。
# @scene prefix_test
# 说明: JSON布尔值，默认false；prefix_cache前缀准备及缓存指标检查；预热请求不算主测请求。
# @scene repeat
# 说明: 正整数，默认1；normal按本次数重复；当前原生prefix_cache忽略repeat，prefix_test=true时仅一次准备+一次主测，false仅一次主测；不等于确认trial次数。
# @scene repeat_rate
# 说明: 0..1数值/数字字符串或"0%".."100%"，默认0；配置重复率，不是实测缓存命中率。
# @scene request_rate
# 说明: 有限非负数，默认0；0不限发送速率，正值为指定RPS约束；实际RPS和并发需看结果。
# @scene seed
# 说明: 任意整数，默认1；控制原生长度采样及前缀构造部分随机逻辑；normal选题未完整受控，不保证重新生成整份文本逐字节可复现。
# 缓存: seed/分布/生成参数改变会隔离到不同dataset_profile；保留同profile原生复用，不能把缓存隔离理解为随机过程完全确定。
# @scene test_accuracy
# 说明: JSON布尔值，默认false；仅固定并发，不能与"max"组合；默认选原生GSM8K真题/金标，不按input_len合成padding；显式dataset全量且answer须含"#### "金标分隔符；性能项留空，模型低准确率不是工具失败。
# @scene test_type
# 说明: "stream"或"text"，默认stream；text没有TTFT/TPOT；摸高只支持stream。
# @scene tpot_limit
# 说明: 有限数值，毫秒；覆盖PEAK_TPOT_LIMIT，仅摸高SLO；<=0关闭此项，等于阈值通过。
# @scene ttft_limit
# 说明: 有限数值，秒；覆盖PEAK_TTFT_LIMIT，仅摸高SLO；<=0关闭此项，等于阈值通过。
#
# 三、独立matrix高级CLI：20个既有选项 + 8个新增选项，共28个。
# 这些是独立aisbench_perf_matrix.py入口的命令行选项，不是全局export变量，也不是可随意添加的场景JSON键。
# 使用已隔离的运行副本和对应运行配置；不要在宿主机原生源码目录中产生临时文件、配置或结果。
# CLI未指定时继承独立Python配置/所选case，并不自动读取本env的PEAK_*全局值。
# 当前独立默认case的TTFT/TPOT为10秒/100毫秒；本env的全局默认为5秒/50毫秒；显式场景字段还能覆盖。
# 根入口自动提供运行身份和输出接线；不要用独立控制选项覆盖批次/任务路径。内置-h/--help用于查看帮助。
# @matrix --auto-expand-max-concurrency
# 说明: 向上扩容保护上限；CLI默认未指定，独立配置默认0=不额外设数值上限；非0时约束全部探测；初始最大值会受该硬上限限制，0仍受轮数和时间预算约束。
# @matrix --case-name
# 说明: 单案例名称覆盖；CLI默认空；不改变根入口的场景身份校验。
# @matrix --cases-json
# 说明: 独立matrix的case列表JSON；CLI默认空，未给时使用选定配置中的案例。
# @matrix --config-file
# 说明: 独立matrix的Python配置文件；默认使用随工具提供的aisbench_perf_matrix_config.py。
# @matrix --confirm-min-requests
# 说明: 整数>=0；每个主测scope的确认请求下限；CLI默认未指定，继承独立case；对应场景peak_confirm_min_requests。
# @matrix --confirm-runs
# 说明: 正整数；每个确认并发点新的工具trial次数，通过/失败两端各执行本次数；CLI默认未指定，继承独立case；对应场景peak_confirm_runs。
# @matrix --failed-req-limit
# 说明: 允许失败请求数，整数>=0；CLI默认未指定，继承独立配置，默认0。
# @matrix --floor-concurrency
# 说明: 正整数；独立硬底配置并发；CLI默认未指定，继承独立case；对应场景peak_floor_cc。
# @matrix --input-len
# 说明: 输入token长度覆盖；CLI默认未指定，继承独立case。
# @matrix --invalid-retries
# 说明: 整数>=0；无效测量的额外重试次数；CLI默认未指定，继承独立case；对应场景peak_invalid_retries。
# @matrix --live-results-csv
# 说明: 实时轮次结果CSV路径；CLI默认空；根入口管理此路径，必须位于允许的结果目录。
# @matrix --max-concurrency
# 说明: 初始上界覆盖；CLI默认未指定，继承独立case；不单独保证禁止扩容。
# @matrix --max-trials
# 说明: 正整数；工具trial总次数预算；CLI默认未指定，继承独立case；对应场景peak_max_trials。
# @matrix --min-concurrency
# 说明: 初始基线并发覆盖；CLI默认未指定，继承独立case。
# @matrix --output-len
# 说明: 输出token长度覆盖；CLI默认未指定，继承独立case，摸高至少2。
# @matrix --precision
# 说明: 正整数；配置并发的边界间隔；CLI默认未指定，继承独立case；对应场景peak_precision。
# @matrix --python-bin
# 说明: 调用原生工具的Python解释器；CLI默认当前sys.executable，需匹配运行环境。
# @matrix --repeat-rate
# 说明: 实时结果的配置重复率标记；CLI默认0；不是实测命中率。
# @matrix --request-multiplier
# 说明: 每scope请求数倍率覆盖；CLI默认未指定，继承独立case。
# @matrix --request-rate
# 说明: 请求发送RPS覆盖；CLI默认未指定，继承独立case；0不限速。
# @matrix --run-tag
# 说明: 可选运行标记后缀；CLI默认空；根入口会生成并管理，不作为JSON任意透传。
# @matrix --total-timeout
# 说明: 有限数值>0；秒；CLI默认未指定，继承独立case；对应场景peak_total_timeout。
# @matrix --tpot-column
# 说明: TPOT源CSV字段名；CLI默认未指定，独立配置默认TPOT avg。
# @matrix --tpot-limit
# 说明: TPOT阈值，毫秒；CLI默认未指定，继承独立case；<=0关闭此SLO。
# @matrix --trial-timeout
# 说明: 有限数值>0；秒；CLI默认未指定，继承独立case；对应场景peak_trial_timeout。
# @matrix --ttft-column
# 说明: TTFT源CSV字段名；CLI默认未指定，独立配置默认TTFT avg。
# @matrix --ttft-limit
# 说明: TTFT阈值，秒；CLI默认未指定，继承独立case；<=0关闭此SLO。
# @matrix --wait-seconds
# 说明: 轮次间等待，整数>=0秒；CLI默认未指定，继承独立case。
#
# 四、内部/固定/停用项，不作为用户可调全局参数。
# SCENARIOS_JSON：只在文件中保留一个字面JSON块，不能export给子进程。
# SCENARIOS_JSON_OVERRIDE：已停用；如旧环境仍设置，unset后把场景写入本文件。
# CONTAINER_OUTPUT_DIR、MODEL_CONTAINER_PATH、TOOLS_CONTAINER_DIR：内部固定路径，不能靠env覆盖。
# ADD_DIR、PROJECT_ROOT、SCENARIO_CONFIG_FILE：历史内部定位量；用户通过根入口与配置文件参数选择位置。
# AISBENCH_*运行身份/报告/事件等内部参数由入口生成；不要在用户配置中赋值。
# PATH及Docker客户端环境属于运行依赖；本机互斥不是跨主机中央锁，不自动确认不同代理是否共享后端。
# ===== END CONFIGURATION REFERENCE =====
