# Public complete example B. Edit actual model, path, endpoint and NPU count first.
# Run alone: bash run_perf_scenarios.sh automation/examples/test_b.env
# Or pass 1..N complete config files to run independent services in parallel.
# Explicit config arguments are loaded automatically; no source is needed.
export MODEL_NAME=your-model-b
export MODEL_HOST_PATH=/mnt/models/your-model-b
export HOST_IP=192.168.1.20
export HOST_PORT=8000
export EXPECTED_IMAGE=ghcr.io/aisbench/aisbench_benchmark:v3.1-20261013-master-openeuler24.03-py311
# single_* throughput = global throughput / NPU_NUM; declare cards or NPU chips in your report.
export NPU_NUM=1
export POD_INFO=""
export API_KEY=""
export API_URL=""
# API_URL is a base URL, e.g. http://192.168.1.20:8000/ or http://192.168.1.20:8000/gateway/.
# The default image adds a trailing slash, then v1/chat/completions; do not include /v1/ or the full chat endpoint.
# Same API_URL host/port (or HOST_IP/HOST_PORT) is forbidden within/across local batches.
# Another model alias or URL path does not make the endpoint independent.
# For distinct proxies sharing one backend, set the same ID in every related config:
# export SERVICE_ID=shared-backend-01
# Different ports may run together only when they represent independent model instances.
# These locks coordinate this host only; coordinate other benchmark hosts separately.
# SIGKILL does not prove container workload ended: active records retain isolation until trusted completion/fixed-ID evidence.
# Recovery marks the old batch_state interrupted/MANAGER_LOST; old immutable snapshots may still say running. Never delete locks to bypass.
export MAX_CONTEXT_LEN=4096
export DATA_NUM_MULTIPLIER=4
export PEAK_HARD_CAP=1
# Task name comes from the actual config file name; a/b are examples, not fixed groups.
# Default container: aisbench-test_b-<batch_id> (new name for each batch).
# Output labels include test_b__your-model-b.
# Defaults: outputs/default/<batch>/tasks/test_b__your-model-b/
# Named CSV: test_b__your-model-b__all_results.csv
# Named log: test_b__your-model-b__launcher.log
# Optional CONTAINER_NAME / HOST_OUTPUT_DIR must be distinct for every task.
# Batch status/merged metrics record task/model, actual paths, timezone and redacted config.

# Edit the JSON here. The launcher reads it from this file, not from an environment variable.
SCENARIOS_JSON=$(cat <<'JSON'
[
  {
    "name": "smoke_b",
    "input_len": "1024",
    "output_len": "512",
    "concurrency": [4],
    "request_rate": "0"
  }
]
JSON
)
export -n SCENARIOS_JSON

# ===== BEGIN CONFIGURATION REFERENCE =====
# 以下全部为注释参考，不在source时执行；实际修改请在上半部分增加/修改赋值，或编辑SCENARIOS_JSON中的场景。
# 从发布根启动：bash run_perf_scenarios.sh automation/examples/test_b.env
# 显式文件各自隔离加载一次；零参自动加载根env.env，启动前已export的公开全局参数按存在性覆盖。
# 场景只读同一配置文件的字面JSON，不从环境变量读取；无需手动source、无需先cp文件。
# 下列“本文件全局有效值”对应本次发布的示例赋值；不是场景覆盖后的最终值。
# 修改上方配置后，以新赋值、运行日志和脱敏快照为准；这些参考注释不会自动执行或重新计算。
# 代码默认是原始默认值；CONTAINER_NAME、HOST_OUTPUT_DIR、TOOLS_HOST_DIR为空时使用所述自动定位规则。
# 每项示例仍是注释：需要时复制到上方配置区，替换自己的值；不要把整段参考取消注释。
# API_KEY等真实凭据仅放私有配置；outputs和私有配置不进入GitHub。
#
# 一、全部31个公开全局参数（既有23个 + 新增8个摸高控制）
#
# @env CONTAINER_NAME
# 代码默认: ""
# 本文件全局有效值: "" （本文件未赋值，使用代码默认/自动规则）
# 类型/单位: 字符串；Docker名称
# 作用域: 每份配置的专用压测容器
# 覆盖: 无场景覆盖；未设置时由配置文件名和批次号派生
